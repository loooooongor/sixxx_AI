# 六爻 AI 環境變數範例
#
# 使用方式（任選一種）：
#   1) 在「設定」面板介面填入（推薦，會存在 ai/config/llm.json）
#   2) 複製本檔為 .env 並填入，或直接設成系統環境變數
#
# 注意：金鑰只在本機使用，不會上傳到任何第三方（除了你自己選的 LLM 供應商）。

# ── 選用：指定供應商（預設 deepseek）──────────────────────────
# 可選：deepseek | openai | anthropic | gemini | openrouter | moonshot | custom
LIUYAO_LLM_PROVIDER=deepseek

# ── 選用：指定模型（留空則用供應商預設）───────────────────────
# LIUYAO_LLM_MODEL=deepseek-chat

# ── 選用：自訂 OpenAI 相容端點（供應商選 custom 時必填）────────
# LIUYAO_LLM_BASE_URL=https://your-endpoint/v1

# ── API 金鑰（填入你實際使用的那一家即可）──────────────────────
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# MOONSHOT_API_KEY=sk-...
# CUSTOM_LLM_API_KEY=...

# ── 選用：伺服器位址與埠號 ────────────────────────────────────
# LIUYAO_HOST=127.0.0.1
# LIUYAO_PORT=8848
